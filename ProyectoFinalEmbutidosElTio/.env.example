# =====================================================
# EMBUTIDOS EL TIO — Variables de Entorno
# =====================================================
# Copia este archivo como ".env" y completa con tus
# claves reales. NUNCA subas el archivo .env a GitHub.
# =====================================================

# --- Base de Datos (SQL Server) ---
# Formato: Server=NOMBRE_SERVIDOR;Database=NOMBRE_BD;Trusted_Connection=True;TrustServerCertificate=True
ConnectionStrings__DefaultConnection=Server=TU_SERVIDOR;Database=EmbutidosElTio;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True

# --- PayPal REST API ---
# Obtén tus claves en: https://developer.paypal.com/dashboard/applications
PayPal__ClientId=AaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPpQqRrSsTtUuVvWwXx1234567890ABCD
PayPal__Secret=EeFfGgHhIiJjKkLlMmNnOoPpQqRrSsTtUuVvWwXxYyZz0987654321abcdefgh
PayPal__Mode=Sandbox

